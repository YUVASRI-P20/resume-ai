# ============================================================
# InterviewIQ AI — Backend environment configuration (example)
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

# ---- General ----
ENVIRONMENT=local
DEBUG=true

# ---- Server ----
HOST=0.0.0.0
PORT=8001

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ---- Database ----
# Postgres (production). For a zero-setup local run, leave the default
# sqlite URL in app/core/config.py (DATABASE_URL optional).
DATABASE_URL=postgresql+asyncpg://interviewiq:interviewiq@localhost:5432/interviewiq
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS (comma-separated) ----
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
# Raise from 5/min so the frontend login/register flow isn't throttled in dev.
RATE_LIMIT_AUTH=20/minute

# ---- Email ----
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@interviewiq.ai
EMAILS_FROM_NAME=InterviewIQ AI
EMAIL_ENABLED=false

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000/

# ---- Resume storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/resumes
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=resumes
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.txt

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false
